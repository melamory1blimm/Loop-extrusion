       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"FSize", ",", 
          RowBox[{"FontFamily", "->", "\"\<CMU Serif\>\""}], ",", "Black"}], 
         "]"}]}], ",", 
       RowBox[{"FrameTicksStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"FTicksSize", ",", 
          RowBox[{"FontFamily", "->", "\"\<CMU Serif\>\""}], ",", "Black"}], 
         "]"}]}], ",", 
       RowBox[{"AspectRatio", "->", "1"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0.", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "4"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"None", ",", "None"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"None", ",", "None"}], "}"}]}], "}"}]}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"Abnorm", "[", 
         RowBox[{"xi", ",", "20"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"xi", ",", 
         RowBox[{"-", "0.1"}], ",", "1"}], "}"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Dashing", "[", "Small", "]"}], ",", "Blue", ",", 
          RowBox[{"Thickness", "[", "0.015", "]"}]}], "}"}]}], ",", 
       RowBox[{"AspectRatio", "->", "1"}]}], "]"}], ",", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Abnorm", "[", 
           RowBox[{"xi", ",", 
            RowBox[{"1", "/", "lsw"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"lsw", ",", "0.01", ",", "lswmax", ",", "lswstep"}], 
           "}"}]}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"xi", ",", 
         RowBox[{"-", "0.1"}], ",", "1"}], "}"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"ColorData", "[", 
