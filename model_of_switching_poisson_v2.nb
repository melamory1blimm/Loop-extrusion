Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Normalization", " ", "settings"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"histData", ",", "histMax", ",", "pkNormAF", ",", "pkPDF"}], 
     "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lp", "=", "0.431"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lcut", "=", "0.0158"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"binWidth", "=", "0.015"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Experimental", " ", "data", " ", "above", " ", "cutoff"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"histData", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"{", "#", "}"}], "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"NumericQ", "[", "#", "]"}], "&&", 
            RowBox[{"TrueQ", "[", 
             RowBox[{"#", ">=", "lcut"}], "]"}]}], "&"}]}], "]"}], "&"}], 
       ")"}], "/@", 
      RowBox[{"{", 
       RowBox[{"GMrep1", ",", "GMrep2"}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Include", " ", "all", " ", "observed", " ", "lengths", " ", "in", " ", 
     "normalization"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"histMax", "=", 
     RowBox[{"lcut", "+", 
      RowBox[{"binWidth", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Ceiling", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"Flatten", "[", "histData", "]"}], "]"}], "-", "lcut"}],
             ")"}], "/", "binWidth"}], "]"}], "+", "1"}], ")"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Normalization", " ", "for", " ", "each", " ", "theoretical", " ", 
     "curve"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"pkNormAF", "[", 
      RowBox[{"sw_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"pkNormAF", "[", "sw", "]"}], "=", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{"AF", "[", 
         RowBox[{"u", ",", 
          RowBox[{"1.", "/", "sw"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"u", ",", 
          RowBox[{"lcut", "/", "lp"}], ",", "Infinity"}], "}"}], ",", 
        RowBox[{"AccuracyGoal", "->", "8"}], ",", 
        RowBox[{"MaxRecursion", "->", "20"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "PDF", " ", "normalized", " ", "above", " ", "the", " ", "experimental", " ",
      "cutoff"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"pkPDF", "[", 
      RowBox[{"x_", ",", 
       RowBox[{"sw_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"AF", "[", 
       RowBox[{
        RowBox[{"x", "/", "lp"}], ",", 
        RowBox[{"1.", "/", "sw"}]}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"lp", " ", 
        RowBox[{"pkNormAF", "[", "sw", "]"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Precompute", " ", "normalization", " ", "constants"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pkNormAF", "/@", 
     RowBox[{"Join", "[", 
      RowBox[{"lswT", ",", 
       RowBox[{"{", "0.05", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Figure"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Histogram", "[", 
      RowBox[{"histData", ",", 
       RowBox[{"{", 
        RowBox[{"lcut", ",", "histMax", ",", "binWidth"}], "}"}], 
       ",", "\"\<PDF\>\"", ",", 
       RowBox[{"AspectRatio", "->", "1"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"20", ",", 
          RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", "Black"}], 
         "]"}]}], ",", 
       RowBox[{"FrameTicksStyle", "->", 
        RowBox[{"Directive", "[", "20", "]"}]}], ",", 
       RowBox[{"ChartStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Directive", "[", 
           RowBox[{"Blue", ",", 
            RowBox[{"Opacity", "[", "0.3", "]"}], ",", 
            RowBox[{"EdgeForm", "[", "Black", "]"}]}], "]"}], ",", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"RGBColor", "[", 
             RowBox[{"0.5", ",", "0", ",", "0.5"}], "]"}], ",", 
            RowBox[{"Opacity", "[", "0.3", "]"}], ",", 
            RowBox[{"EdgeForm", "[", "Black", "]"}]}], "]"}]}], "}"}]}]}], 
      "]"}], ",", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"pkPDF", "[", 
           RowBox[{"xi", ",", 
            RowBox[{"lswT", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "lswT", "]"}]}], "}"}]}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"xi", ",", "lcut", ",", "1.2"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"ColorData", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<DarkRainbow\>\"", ",", "\"\<Reverse\>\""}], "}"}], 
             "]"}], "[", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "3"}], " ", 
              RowBox[{
               RowBox[{"lswT", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "/", "lswmax"}]}], "]"}], 
            "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "lswT", "]"}]}], "}"}]}], "]"}]}]}], "]"}],
      ",", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"pkPDF", "[", 
         RowBox[{"xi", ",", "0.05"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"xi", ",", "lcut", ",", "1.2"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ColorData", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<DarkRainbow\>\"", ",", "\"\<Reverse\>\""}], "}"}], 
            "]"}], "[", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "3"}], " ", 
             RowBox[{"0.05", "/", "lswmax"}]}], "]"}], "]"}], ",", 
          RowBox[{"Dashing", "[", "Small", "]"}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0.8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "7"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotRangePadding", "->", "None"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"Axes", "->", "False"}], ",", 
     RowBox[{"FrameTicks", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", "8", ",", "2"}], "]"}], ",", "None"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0.", ",", "0.8", ",", "0.2"}], "]"}], ",", "None"}], 
         "}"}]}], "}"}]}], ",", 
     RowBox[{"FrameStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"20", ",", 
        RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", "Black"}], 
       "]"}]}], ",", 
     RowBox[{"FrameTicksStyle", "->", 
      RowBox[{"Directive", "[", "20", "]"}]}], ",", 
     RowBox[{"AspectRatio", "->", "1"}], ",", 
     RowBox[{"ImageSize", "->", "250"}]}], "]"}], "\n"}]}]], "Input",
