              RowBox[{"\"\<DarkRainbow\>\"", ",", "\"\<Reverse\>\""}], "}"}], 
             "]"}], "[", 
            RowBox[{"1", "-", 
             RowBox[{"lsw", "/", "lswmax"}]}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"lsw", ",", "0.01", ",", "lswmax", ",", "lswstep"}], 
           "}"}]}], "]"}]}], ",", 
