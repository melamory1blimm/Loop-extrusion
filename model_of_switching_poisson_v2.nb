Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "KDEs", " ", "with", " ", "the", " ", "same", " ", "bandwidth", " ", "and",
     " ", "boundary", " ", "correction"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"kdeD1", "=", 
     RowBox[{"SmoothKernelDistribution", "[", 
      RowBox[{"kRep1", ",", "kH0", ",", "kKernel"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kdeD2", "=", 
     RowBox[{"SmoothKernelDistribution", "[", 
      RowBox[{"kRep2", ",", "kH0", ",", "kKernel"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Compare", " ", "KDE", " ", "against", " ", "the", " ", "OTHER", " ", 
     "replicate"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kdeD12", "=", 
     RowBox[{"KolmogorovSmirnovTest", "[", 
      RowBox[{"kRep2", ",", "kdeD1", ",", "\"\<TestStatistic\>\""}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kdeD21", "=", 
     RowBox[{"KolmogorovSmirnovTest", "[", 
      RowBox[{"kRep1", ",", "kdeD2", ",", "\"\<TestStatistic\>\""}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<KDE 1 vs replicate 2: D = \>\"", ",", "kdeD12"}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<KDE 2 vs replicate 1: D = \>\"", ",", "kdeD21"}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Empirical", " ", "CDFs"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"empD1", "=", 
     RowBox[{"EmpiricalDistribution", "[", "kRep1", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"empD2", "=", 
