Cell[BoxData[
 RowBox[{
  RowBox[{"gAb", "=", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Histogram", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", "dataAb", "]"}], ",", 
       RowBox[{"{", "bins2", "}"}], ",", "\"\<PDF\>\"", ",", 
       RowBox[{"ChartStyle", "->", 
