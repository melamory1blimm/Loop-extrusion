Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "kCut", ",", "kMax", ",", "kRep1", ",", "kRep2", ",", "kData", ",", "kH0",
      ",", "kKernel", ",", "kFactors", ",", "kPeak", ",", "kResults", ",", 
     "kExpPoints", ",", "kExpPlot"}], "]"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Parameters"}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kCut", "=", "0.0158"}], ";"}], "     ", 
  RowBox[{"(*", "Mb", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kMax", "=", "0.20"}], ";"}], "       ", 
  RowBox[{"(*", 
   RowBox[{"Mb", ";", 
    RowBox[{"peak", " ", "search", " ", "region"}]}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kRep1", "=", 
    RowBox[{"N", "@", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"{", "GMrad21rep1", "}"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"NumericQ", "[", "#", "]"}], "&&", 
         RowBox[{"TrueQ", "[", 
          RowBox[{"#", ">=", "kCut"}], "]"}]}], "&"}]}], "]"}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kRep2", "=", 
    RowBox[{"N", "@", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"{", "GMrad21rep2", "}"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"NumericQ", "[", "#", "]"}], "&&", 
         RowBox[{"TrueQ", "[", 
          RowBox[{"#", ">=", "kCut"}], "]"}]}], "&"}]}], "]"}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kData", "=", 
    RowBox[{"{", 
     RowBox[{"kRep1", ",", "kRep2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "2.", " ", "Common", " ", "bandwidth", " ", "for", " ", "both", " ", 
    "replicates"}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kPool", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"kRep1", ",", "kRep2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kQuartiles", "=", 
    RowBox[{"Quantile", "[", 
     RowBox[{"kPool", ",", 
      RowBox[{"{", 
       RowBox[{"0.25", ",", "0.75"}], "}"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kH0", "=", 
    RowBox[{"0.9", " ", 
     RowBox[{"Min", "[", 
      RowBox[{
       RowBox[{"StandardDeviation", "[", "kPool", "]"}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"kQuartiles", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "-", 
          RowBox[{"kQuartiles", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", "1.34"}]}], "]"}], " ", 
     RowBox[{
      RowBox[{"Length", "[", "kPool", "]"}], "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "/", "5"}], ")"}]}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kKernel", "=", 
    RowBox[{"{", 
     RowBox[{"\"\<Bounded\>\"", ",", 
      RowBox[{"{", 
       RowBox[{"kCut", ",", "Infinity"}], "}"}], ",", "\"\<Gaussian\>\""}], 
     "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Bandwidth", " ", "sensitivity"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kFactors", "=", 
    RowBox[{"{", 
     RowBox[{"0.7", ",", "0.85", ",", "1.0", ",", "1.15", ",", "1.3"}], 
     "}"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "3.", " ", "Find", " ", "peak", " ", "of", " ", "the", " ", "smooth", " ", 
    "density"}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"kPeak", "[", 
     RowBox[{"data_", ",", "hh_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dist", ",", "grid", ",", "vals", ",", "idx"}], "}"}], ",", 
      RowBox[{
       RowBox[{"dist", "=", 
        RowBox[{"SmoothKernelDistribution", "[", 
         RowBox[{"data", ",", "hh", ",", "kKernel"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"grid", "=", 
        RowBox[{"N", "@", 
         RowBox[{"Subdivide", "[", 
          RowBox[{"kCut", ",", "kMax", ",", "4000"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vals", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"PDF", "[", 
            RowBox[{"dist", ",", "#"}], "]"}], "&"}], "/@", "grid"}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"idx", "=", 
        RowBox[{"First", "@", 
         RowBox[{"Ordering", "[", 
          RowBox[{"vals", ",", 
           RowBox[{"-", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"grid", "[", 
          RowBox[{"[", "idx", "]"}], "]"}], ",", 
         RowBox[{"vals", "[", 
          RowBox[{"[", "idx", "]"}], "]"}]}], "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "4.", " ", "Peak", " ", "and", " ", "sensitivity", " ", "for", " ", "each",
     " ", "replicate"}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kResults", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p0", ",", "variants", ",", "err"}], "}"}], ",", 
        RowBox[{
         RowBox[{"p0", "=", 
          RowBox[{"kPeak", "[", 
           RowBox[{
            RowBox[{"kData", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", "kH0"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"variants", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"kPeak", "[", 
             RowBox[{
              RowBox[{"kData", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{"factor", " ", "kH0"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"factor", ",", "kFactors"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"err", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"variants", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "j"}], "]"}], "]"}], "-", 
